# ============================================================
#  .gitignore  ——  南昌大学 课程实验作品集
#  作用：告诉 Git「哪些文件不要纳入版本管理」
#  规则：以 # 开头的是注释；/ 结尾表示只忽略目录
# ============================================================

# ---------- 1. 操作系统自动生成的垃圾文件 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*~

# ---------- 2. 编辑器 / IDE 配置 ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*.bak
*.tmp

# ---------- 3. Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.python-version
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- 4. Node.js / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
.nuxt/
dist/
.cache/
coverage/
*.local

# ---------- 5. Java / Kotlin ----------
*.class
*.jar
!.gradle/wrapper/gradle-wrapper.jar
target/
.gradle/
out/
*.log

# ---------- 6. C / C++ ----------
*.o
*.obj
*.exe
*.out
*.dll
*.lib
*.pdb
*.ilk
cmake-build-*/

# ---------- 7. 数据库 / 数据文件 ----------
*.db
*.sqlite
*.sqlite3
*.mdb

# ---------- 8. 大文件 / 导出物 ----------
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.iso

# ---------- 9. 机密与个人配置（非常重要！）----------
# 永远不要把密码、密钥、Token 提交到仓库
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
credentials.json
*secret*
*token*
!*.token.example

# ---------- 10. 本课程的临时/中间产物 ----------
# 如果你希望某些实验产物也提交，把下面的规则删掉即可
**/output/
**/results/
**/.temp/
scratch/
